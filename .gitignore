# ============================================================
# specwright .gitignore
# ============================================================

# ---- OS files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Editors / IDEs ----
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# ---- Backups created by installers / hooks ----
*.bak.*
*.bak
*.backup

# ---- Claude Code local state ----
.claude/.hookstate/
.claude/settings.local.json
.claude/.cache/

# ---- Local AI work docs (not shipped) ----
.ai-docs/

# ---- Logs ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Node.js ----
node_modules/
.npm
.yarn-integrity
.pnp.*
.next/
out/
dist/
build/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- .NET / C# ----
bin/
obj/
*.dll
*.exe
*.pdb
.vs/
TestResults/

# ---- Rust ----
target/
Cargo.lock.bak

# ---- Go ----
vendor/

# ---- Java / Kotlin ----
*.class
*.jar
*.war
.gradle/
gradle/

# ---- Misc build outputs ----
coverage/
# Hook fixtures carry a spec's 04-artifacts/coverage/ evidence on purpose (SW-118)
!tests/hooks/fixtures/**/coverage/
.nyc_output/
tmp/
temp/

# ---- Archives ----
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# ---- Environment / secrets ----
.env
.env.local
.env.*.local
*.pem
*.key
