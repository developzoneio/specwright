{
  "spec": {
    "dir": ".specs",
    "indexFile": ".specs/index.md",
    "prefixes": { "feature": "FEAT", "bug": "BUG", "refactor": "REF", "perf": "PERF", "rca": "RCA", "port": "PORT", "hotfix": "HOTFIX" }
  },
  "paths": { "protected": [".specs/constitution.md"] },
  "hooks": { "specGate": { "enabled": true, "mode": "block" } }
}
